<Window x:Class="UI.View.LatencyTestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="ExtraLight"
        TextElement.FontSize="12"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{DynamicResource MaterialDesignFont}"
        WindowStartupLocation="CenterOwner"
        Title="Latency Test"
        Width="1450"
        Height="900">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel Orientation="Vertical">
            <DockPanel>
                <Button DockPanel.Dock="Left"
                        Style="{StaticResource MaterialDesignIconForegroundButton}"
                        Command="{Binding ShowAboutWindowCommand}"
                        ToolTip="About">
                    <materialDesign:PackIcon Kind="Information" />
                </Button>

                <TextBlock Style="{StaticResource MaterialDesignHeadline2TextBlock}"
                           Text="Test - Latency"
                           Margin="10"
                           HorizontalAlignment="Center" />
            </DockPanel>

            <materialDesign:Card materialDesign:ElevationAssist.Elevation="Dp16"
                                 UniformCornerRadius="15"
                                 Margin="10"
                                 Padding="15">
                <StackPanel>
                    <TextBlock Style="{StaticResource MaterialDesignHeadline4TextBlock}"
                               Text="Latency Evaluation"
                               HorizontalAlignment="Center"
                               Margin="10,5,10,10" />
                    <TextBlock Style="{StaticResource MaterialDesignBody1TextBlock}"
                               Text="Primary scientific metric: ensemble model inference time for the complete frontal + lateral case across all selected folds. Image loading/preprocessing and WPF/HTTP overhead are excluded. CUDA runs use CUDA events with explicit synchronization. End-to-end application latency is kept separately as an engineering metric."
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="20,0,20,10" />
                </StackPanel>
            </materialDesign:Card>

            <materialDesign:Card UniformCornerRadius="15"
                                 Margin="10"
                                 Padding="20">
                <StackPanel>
                    <TextBlock Style="{StaticResource MaterialDesignHeadline4TextBlock}"
                               Text="Test Configuration"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,20" />

                    <TextBlock Style="{StaticResource MaterialDesignBody1TextBlock}"
                               Text="Model Folder"
                               HorizontalAlignment="Center"
                               Margin="0,5,0,5" />

                    <materialDesign:Badged HorizontalAlignment="Center"
                                           Margin="20,5,20,0"
                                           Badge="{Binding ModelSelectionFolderBadge}"
                                           BadgeColorZoneMode="SecondaryMid">
                        <Button Command="{Binding BrowseModelFolderCommand}">Select Model Folder</Button>
                    </materialDesign:Badged>

                    <TextBlock Style="{StaticResource MaterialDesignOverlineTextBlock}"
                               Text="{Binding ModelSelectionFolder}"
                               IsEnabled="False"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="20,10,20,20" />

                    <Separator Margin="20,5,20,20" />

                    <TextBlock Style="{StaticResource MaterialDesignBody1TextBlock}"
                               Text="Dataset Folder"
                               HorizontalAlignment="Center"
                               Margin="0,5,0,5" />

                    <Button HorizontalAlignment="Center"
                            Margin="20,5,20,0"
                            Padding="20,6"
                            Click="SelectLatencyDataset_Click">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FolderOpen"
                                                     Width="20"
                                                     Height="20"
                                                     Margin="0,0,8,0" />
                            <TextBlock Text="Select Dataset Folder"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <TextBlock x:Name="LatencyDatasetPathText"
                               Style="{StaticResource MaterialDesignOverlineTextBlock}"
                               Text="No dataset folder selected"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="20,10,20,5" />

                    <TextBlock Style="{StaticResource MaterialDesignCaptionTextBlock}"
                               Text="The dataset folder is scanned for matching frontal (_C_) and lateral (_S_) NIfTI sequences."
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="20,0,20,20" />

                    <Separator Margin="20,5,20,20" />

                    <Button x:Name="StartLatencyTestButton"
                            HorizontalAlignment="Center"
                            Margin="10"
                            Padding="30,10"
                            IsEnabled="False"
                            Click="StartLatencyTestButton_Click"
                            ToolTip="Select a dataset before starting the test">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Timer"
                                                     Width="24"
                                                     Height="24"
                                                     Margin="0,0,10,0" />
                            <TextBlock Text="START LATENCY TEST"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </materialDesign:Card>

            <materialDesign:Card UniformCornerRadius="15"
                                 Margin="10"
                                 Padding="20">
                <StackPanel>
                    <TextBlock Style="{StaticResource MaterialDesignHeadline4TextBlock}"
                               Text="Test Progress"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,15" />
                    <ProgressBar x:Name="LatencyProgressBar"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="0"
                                 Height="8"
                                 Margin="20,5,20,10" />
                    <TextBlock x:Name="LatencyProgressText"
                               Style="{StaticResource MaterialDesignCaptionTextBlock}"
                               Text="Waiting to start"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Margin="10" />
                </StackPanel>
            </materialDesign:Card>

            <!-- Primary paper-oriented result -->
            <materialDesign:Card UniformCornerRadius="15"
                                 Margin="10"
                                 Padding="20">
                <StackPanel>
                    <TextBlock Style="{StaticResource MaterialDesignHeadline4TextBlock}"
                               Text="Primary Result - Ensemble Inference"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8" />
                    <TextBlock Style="{StaticResource MaterialDesignCaptionTextBlock}"
                               Text="One row = one paired DSA case. The reported inference time is the sum of pure frontal + lateral model execution over all selected folds. It excludes image preprocessing, model transfer, HTTP communication and WPF overhead."
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="20,0,20,15" />

                    <DataGrid x:Name="LatencyResultsGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              HeadersVisibility="Column"
                              MinHeight="220"
                              MaxHeight="360"
                              Margin="5"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Case"
                                                Binding="{Binding CaseName}"
                                                Width="2*" />
                            <DataGridTextColumn Header="Classification"
                                                Binding="{Binding Classification}"
                                                Width="2*" />
                            <DataGridTextColumn Header="Ensemble inference (ms)"
                                                Binding="{Binding BackendInferenceMilliseconds}"
                                                Width="1.4*" />
                            <DataGridTextColumn Header="Execution"
                                                Binding="{Binding ExecutionProvider}"
                                                Width="*" />
                            <DataGridTextColumn Header="Device"
                                                Binding="{Binding TimingDevice}"
                                                Width="*" />
                            <DataGridTextColumn Header="Status"
                                                Binding="{Binding Status}"
                                                Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Style="{StaticResource MaterialDesignBody1TextBlock}"
                               FontSize="18"
                               Text="Ensemble Inference Summary"
                               HorizontalAlignment="Center"
                               Margin="0,18,0,5" />

                    <UniformGrid Columns="5">
                        <materialDesign:Card Margin="5">
                            <StackPanel Margin="10">
                                <TextBlock Style="{StaticResource MaterialDesignOverlineTextBlock}"
                                           Text="CASES"
                                           HorizontalAlignment="Center" />
                                <TextBlock x:Name="LatencyCaseCountText"
                                           Text="0"
                                           FontSize="20"
                                           HorizontalAlignment="Center"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </materialDesign:Card>
                        <materialDesign:Card Margin="5">
                            <StackPanel Margin="10">
                                <TextBlock Style="{StaticResource MaterialDesignOverlineTextBlock}"
                                           Text="MEAN INFERENCE"
                                           HorizontalAlignment="Center" />
                                <TextBlock x:Name="LatencyAverageText"
                                           Text="- ms"
                                           FontSize="20"
                                           HorizontalAlignment="Center"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </materialDesign:Card>
                        <materialDesign:Card Margin="5">
                            <StackPanel Margin="10">
                                <TextBlock Style="{StaticResource MaterialDesignOverlineTextBlock}"
                                           Text="MIN"
                                           HorizontalAlignment="Center" />
                                <TextBlock x:Name="LatencyMinText"
                                           Text="- ms"
                                           FontSize="20"
                                           HorizontalAlignment="Center"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </materialDesign:Card>
                        <materialDesign:Card Margin="5">
                            <StackPanel Margin="10">
                                <TextBlock Style="{StaticResource MaterialDesignOverlineTextBlock}"
                                           Text="MAX"
                                           HorizontalAlignment="Center" />
                                <TextBlock x:Name="LatencyMaxText"
                                           Text="- ms"
                                           FontSize="20"
                                           HorizontalAlignment="Center"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </materialDesign:Card>
                        <materialDesign:Card Margin="5">
                            <StackPanel Margin="10">
                                <TextBlock Style="{StaticResource MaterialDesignOverlineTextBlock}"
                                           Text="EXECUTION / DEVICE"
                                           HorizontalAlignment="Center" />
                                <TextBlock x:Name="ExecutionSummaryText"
                                           Text="-"
                                           FontSize="18"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </materialDesign:Card>
                    </UniformGrid>

                    <TextBlock x:Name="TimingMethodSummaryText"
                               Style="{StaticResource MaterialDesignCaptionTextBlock}"
                               Text="Timing method: -"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Margin="10,8,10,0" />
                </StackPanel>
            </materialDesign:Card>

            <!-- Secondary engineering metric -->
            <materialDesign:Card UniformCornerRadius="15"
                                 Margin="10"
                                 Padding="20">
                <StackPanel>
                    <TextBlock Style="{StaticResource MaterialDesignHeadline4TextBlock}"
                               Text="Engineering Metric - End-to-End Application Latency"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8" />
                    <TextBlock Style="{StaticResource MaterialDesignCaptionTextBlock}"
                               Text="Secondary metric only. Measures the WPF client classification path across all folds after image preparation, including HTTP requests, Flask/backend overhead, model transfer and serialization."
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="20,0,20,15" />

                    <UniformGrid Columns="3">
                        <materialDesign:Card Margin="8">
                            <StackPanel Margin="15">
                                <TextBlock Style="{StaticResource MaterialDesignOverlineTextBlock}"
                                           Text="MEAN END-TO-END"
                                           HorizontalAlignment="Center" />
                                <TextBlock x:Name="EndToEndAverageText"
                                           Text="- ms"
                                           FontSize="22"
                                           HorizontalAlignment="Center"
                                           Margin="0,5,0,0" />
                            </StackPanel>
                        </materialDesign:Card>
                        <materialDesign:Card Margin="8">
                            <StackPanel Margin="15">
                                <TextBlock Style="{StaticResource MaterialDesignOverlineTextBlock}"
                                           Text="MIN END-TO-END"
                                           HorizontalAlignment="Center" />
                                <TextBlock x:Name="EndToEndMinText"
                                           Text="- ms"
                                           FontSize="22"
                                           HorizontalAlignment="Center"
                                           Margin="0,5,0,0" />
                            </StackPanel>
                        </materialDesign:Card>
                        <materialDesign:Card Margin="8">
                            <StackPanel Margin="15">
                                <TextBlock Style="{StaticResource MaterialDesignOverlineTextBlock}"
                                           Text="MAX END-TO-END"
                                           HorizontalAlignment="Center" />
                                <TextBlock x:Name="EndToEndMaxText"
                                           Text="- ms"
                                           FontSize="22"
                                           HorizontalAlignment="Center"
                                           Margin="0,5,0,0" />
                            </StackPanel>
                        </materialDesign:Card>
                    </UniformGrid>
                </StackPanel>
            </materialDesign:Card>

            <!-- Detailed diagnostics are collapsed by default to keep the main results readable. -->
            <materialDesign:Card UniformCornerRadius="15"
                                 Margin="10"
                                 Padding="20">
                <Expander Header="Detailed Per-Fold Timing (optional)"
                          IsExpanded="False">
                    <StackPanel Margin="0,15,0,0">
                        <TextBlock Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                   Text="Diagnostic detail only. Each row is one DSA sequence processed by one fold. CPU/GPU and device are shown per row."
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="10,0,10,15" />

                        <TextBlock Style="{StaticResource MaterialDesignBody1TextBlock}" FontSize="22"
                                   Text="Frontal View - Per Case / Per Fold"
                                   HorizontalAlignment="Center"
                                   Margin="0,5,0,5" />
                        <TextBlock x:Name="FrontalLatencyStatusText"
                                   Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                   Text="Run the test to collect frontal per-case / per-fold timings."
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="10,0,10,8" />
                        <DataGrid x:Name="FrontalLatencyGrid"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  HeadersVisibility="Column"
                                  Height="260"
                                  Margin="5"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Case / Data"
                                                    Binding="{Binding CaseName}"
                                                    Width="2*" />
                                <DataGridTextColumn Header="Model / Fold"
                                                    Binding="{Binding ModelName}"
                                                    Width="*" />
                                <DataGridTextColumn Header="Frontal inference (ms)"
                                                    Binding="{Binding LatencyMilliseconds, StringFormat=F2}"
                                                    Width="1.3*" />
                                <DataGridTextColumn Header="Execution"
                                                    Binding="{Binding ExecutionProvider}"
                                                    Width="*" />
                                <DataGridTextColumn Header="Device"
                                                    Binding="{Binding TimingDevice}"
                                                    Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <UniformGrid Columns="5" Margin="0,0,0,20">
                            <materialDesign:Card Margin="5"><StackPanel Margin="10"><TextBlock Text="SEQUENCES" HorizontalAlignment="Center"/><TextBlock x:Name="FrontalSequenceCountText" Text="0" FontSize="18" HorizontalAlignment="Center"/></StackPanel></materialDesign:Card>
                            <materialDesign:Card Margin="5"><StackPanel Margin="10"><TextBlock Text="MEASUREMENTS" HorizontalAlignment="Center"/><TextBlock x:Name="FrontalMeasurementCountText" Text="0" FontSize="18" HorizontalAlignment="Center"/></StackPanel></materialDesign:Card>
                            <materialDesign:Card Margin="5"><StackPanel Margin="10"><TextBlock Text="MIN" HorizontalAlignment="Center"/><TextBlock x:Name="FrontalMinText" Text="- ms" FontSize="18" HorizontalAlignment="Center"/></StackPanel></materialDesign:Card>
                            <materialDesign:Card Margin="5"><StackPanel Margin="10"><TextBlock Text="AVERAGE" HorizontalAlignment="Center"/><TextBlock x:Name="FrontalAverageText" Text="- ms" FontSize="18" HorizontalAlignment="Center"/></StackPanel></materialDesign:Card>
                            <materialDesign:Card Margin="5"><StackPanel Margin="10"><TextBlock Text="MAX" HorizontalAlignment="Center"/><TextBlock x:Name="FrontalMaxText" Text="- ms" FontSize="18" HorizontalAlignment="Center"/></StackPanel></materialDesign:Card>
                        </UniformGrid>

                        <Separator Margin="15,5,15,20" />

                        <TextBlock Style="{StaticResource MaterialDesignBody1TextBlock}" FontSize="22"
                                   Text="Lateral View - Per Case / Per Fold"
                                   HorizontalAlignment="Center"
                                   Margin="0,5,0,5" />
                        <TextBlock x:Name="LateralLatencyStatusText"
                                   Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                   Text="Run the test to collect lateral per-case / per-fold timings."
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="10,0,10,8" />
                        <DataGrid x:Name="LateralLatencyGrid"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  HeadersVisibility="Column"
                                  Height="260"
                                  Margin="5"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Case / Data"
                                                    Binding="{Binding CaseName}"
                                                    Width="2*" />
                                <DataGridTextColumn Header="Model / Fold"
                                                    Binding="{Binding ModelName}"
                                                    Width="*" />
                                <DataGridTextColumn Header="Lateral inference (ms)"
                                                    Binding="{Binding LatencyMilliseconds, StringFormat=F2}"
                                                    Width="1.3*" />
                                <DataGridTextColumn Header="Execution"
                                                    Binding="{Binding ExecutionProvider}"
                                                    Width="*" />
                                <DataGridTextColumn Header="Device"
                                                    Binding="{Binding TimingDevice}"
                                                    Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <UniformGrid Columns="5">
                            <materialDesign:Card Margin="5"><StackPanel Margin="10"><TextBlock Text="SEQUENCES" HorizontalAlignment="Center"/><TextBlock x:Name="LateralSequenceCountText" Text="0" FontSize="18" HorizontalAlignment="Center"/></StackPanel></materialDesign:Card>
                            <materialDesign:Card Margin="5"><StackPanel Margin="10"><TextBlock Text="MEASUREMENTS" HorizontalAlignment="Center"/><TextBlock x:Name="LateralMeasurementCountText" Text="0" FontSize="18" HorizontalAlignment="Center"/></StackPanel></materialDesign:Card>
                            <materialDesign:Card Margin="5"><StackPanel Margin="10"><TextBlock Text="MIN" HorizontalAlignment="Center"/><TextBlock x:Name="LateralMinText" Text="- ms" FontSize="18" HorizontalAlignment="Center"/></StackPanel></materialDesign:Card>
                            <materialDesign:Card Margin="5"><StackPanel Margin="10"><TextBlock Text="AVERAGE" HorizontalAlignment="Center"/><TextBlock x:Name="LateralAverageText" Text="- ms" FontSize="18" HorizontalAlignment="Center"/></StackPanel></materialDesign:Card>
                            <materialDesign:Card Margin="5"><StackPanel Margin="10"><TextBlock Text="MAX" HorizontalAlignment="Center"/><TextBlock x:Name="LateralMaxText" Text="- ms" FontSize="18" HorizontalAlignment="Center"/></StackPanel></materialDesign:Card>
                        </UniformGrid>
                    </StackPanel>
                </Expander>
            </materialDesign:Card>

            <materialDesign:Card UniformCornerRadius="15"
                                 Margin="10"
                                 Padding="20">
                <StackPanel>
                    <TextBlock Style="{StaticResource MaterialDesignHeadline4TextBlock}"
                               Text="Dataset / Test Totals"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,15" />
                    <UniformGrid Columns="3">
                        <materialDesign:Card Margin="8">
                            <StackPanel Margin="15">
                                <TextBlock Style="{StaticResource MaterialDesignOverlineTextBlock}"
                                           Text="TOTAL DSA SEQUENCES"
                                           HorizontalAlignment="Center" />
                                <TextBlock x:Name="TotalSelectedSequenceText"
                                           Text="0"
                                           FontSize="22"
                                           HorizontalAlignment="Center"
                                           Margin="0,5,0,0" />
                            </StackPanel>
                        </materialDesign:Card>
                        <materialDesign:Card Margin="8">
                            <StackPanel Margin="15">
                                <TextBlock Style="{StaticResource MaterialDesignOverlineTextBlock}"
                                           Text="MODELS / FOLDS"
                                           HorizontalAlignment="Center" />
                                <TextBlock x:Name="TotalModelCountText"
                                           Text="-"
                                           FontSize="22"
                                           HorizontalAlignment="Center"
                                           Margin="0,5,0,0" />
                            </StackPanel>
                        </materialDesign:Card>
                        <materialDesign:Card Margin="8">
                            <StackPanel Margin="15">
                                <TextBlock Style="{StaticResource MaterialDesignOverlineTextBlock}"
                                           Text="DETAILED VIEW-FOLD MEASUREMENTS"
                                           HorizontalAlignment="Center" />
                                <TextBlock x:Name="TotalViewMeasurementText"
                                           Text="0"
                                           FontSize="22"
                                           HorizontalAlignment="Center"
                                           Margin="0,5,0,0" />
                            </StackPanel>
                        </materialDesign:Card>
                    </UniformGrid>
                </StackPanel>
            </materialDesign:Card>
        </StackPanel>
    </ScrollViewer>
</Window>
